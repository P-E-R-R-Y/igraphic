digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="IModule",height=0.2,width=0.4,color="grey60", fillcolor="#E0E0E0", style="filled",tooltip=" "];
  Node0 -> Node1 [id="edge3_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="IGraphic2Module",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classIGraphic2Module.html",tooltip="A vendor's 2D factory : window, input, loaded resources and the objects that reference them...."];
  Node1 -> Node2 [id="edge4_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="IGraphic3Module",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classIGraphic3Module.html",tooltip="A vendor's 3D factory. Extends IGraphic2Module : implementing it means implementing all of the 2D too..."];
}
